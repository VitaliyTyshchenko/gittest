version: 2
updates:
  - package-ecosystem: "github-actions"
    directory: "/"
    schedule:
      interval: "weekly"
    groups:
      github-actions:
        patterns:
          - "*"
    reviewers:
      - "VitaliyTyshchenko"
    commit-message:
      prefix: "ci"

  - package-ecosystem: "docker"
    directory: "/"
    schedule:
      interval: "weekly"
    groups:
      docker-minor:
        update-types:
          - "minor"
          - "patch"
      docker-major:
        update-types:
          - "major"
    reviewers:
      - "VitaliyTyshchenko"
    commit-message:
      prefix: "deps"
    labels:
      - "dependencies"
      - "security"
